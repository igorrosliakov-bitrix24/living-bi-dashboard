# API base URL. Usually this value does not need to change.
VIBECODE_API_BASE=https://vibecode.bitrix24.tech

# Local development: personal developer key. Do not use it in Galaxy production.
VIBECODE_API_KEY=vibe_api_replace_me

# Production: OAuth application key for the portal. The browser never receives this value.
VIBE_APP_KEY=vibe_app_replace_me

# Optional: OAuth token from a local Bitrix24 application with biconnector scope.
# Used only by BI dataset API experiments, never by the browser.
BITRIX24_PORTAL_URL=https://your-portal.bitrix24.ru
BITRIX24_OAUTH_ACCESS_TOKEN=replace_me

# Incoming Bitrix24 webhook. It is used for read-only portal checks and must stay only in .env.
BITRIX24_REST_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/user-id/secret/

# Public callback address for the temporary BI connector experiment.
# Galaxy Black Hole URLs require Gateway authorization and cannot be used here.
BI_CONNECTOR_BASE_URL=https://public-adapter.example.com

# Optional local settings.
# PORT=5174
# DASHBOARD_STATE_PATH=.data/dashboard-state.json
BITRIX24_OAUTH_CLIENT_ID=
BITRIX24_OAUTH_CLIENT_SECRET=
OAUTH_ADAPTER_STATE_PATH=/tmp/living-bi-chepyuk-auth.json
# Production only: a long random secret that encrypts OAuth state on disk.
# Keep it in the host's secret store, never in Git.
OAUTH_STATE_ENCRYPTION_KEY=
# One-time deployment migration only. Never keep a value here after the adapter starts.
# OAUTH_INITIAL_STATE_BASE64=
BI_CONNECTOR_STATUS_PATH=/tmp/living-bi-connector-status.json
# Shared only between the dashboard BFF and the dedicated adapter.
ADAPTER_CONTROL_KEY=
DATASET_REGISTRY_PATH=/opt/data/state/dataset-specs.json
