# Optional authorization for the Bitrix24 local application's installation callback.
# Keep actual values only on the adapter server, never in Git.
BITRIX24_APPLICATION_TOKEN=
BITRIX24_INSTALL_SECRET=
OAUTH_ADAPTER_STATE_PATH=/var/lib/living-bi-adapter/auth.json
# Create a long random value and store it only in this protected server file.
OAUTH_STATE_ENCRYPTION_KEY=
ADAPTER_CONTROL_KEY=
DATASET_REGISTRY_PATH=/opt/data/state/dataset-specs.json
# One-time migration only; remove it from the server environment after a successful start.
# OAUTH_INITIAL_STATE_BASE64=
